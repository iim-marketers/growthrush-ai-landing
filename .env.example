# --- Database ---------------------------------------------------------------
# Neon/Vercel Postgres sets both of these. Payload uses the direct (unpooled)
# URL when present, because schema pushes in development need a real session.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# --- Payload ----------------------------------------------------------------
# Signs admin auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Seeded into the users collection by `pnpm seed`, and the credentials you then
# sign in with at /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Media storage ----------------------------------------------------------
# Vercel Blob read/write token. Without it, uploads fall back to local disk
# (public/media), which does not work on serverless hosts.
BLOB_READ_WRITE_TOKEN=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
